{
	"name": "@oofp/react",
	"version": "2.0.0",
	"description": "Functional React component model using Reader monads from @oofp/core",
	"license": "MIT",
	"author": "thexpert507",
	"homepage": "https://oofp.pages.dev/packages/react/",
	"bugs": {
		"url": "https://github.com/thexpert507/oofp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thexpert507/oofp.git",
		"directory": "packages/react"
	},
	"keywords": [
		"functional-programming",
		"typescript",
		"fp",
		"react",
		"reader",
		"monad",
		"components",
		"type-safe"
	],
	"type": "module",
	"main": "./dist/es/index.js",
	"module": "./dist/es/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/es/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"import": "./dist/es/state/index.js",
			"require": "./dist/cjs/state/index.cjs"
		}
	},
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json && vite build",
		"test": "echo 'No tests yet'",
		"test:watch": "echo 'No tests yet'",
		"type-check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@oofp/core": "workspace:*",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"immer": "^10.1.1"
	},
	"devDependencies": {
		"@oofp/core": "workspace:*",
		"@oofp/focal": "workspace:*",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	}
}
