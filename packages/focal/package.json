{
	"name": "@oofp/focal",
	"version": "2.0.0",
	"description": "Composable optics for TypeScript — Lens, Prism, Traversal and Iso, pipe/flow friendly",
	"license": "MIT",
	"author": "thexpert507",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thexpert507/oofp.git",
		"directory": "packages/focal"
	},
	"keywords": [
		"functional-programming",
		"typescript",
		"fp",
		"optics",
		"lens",
		"prism",
		"traversal",
		"iso",
		"pipe",
		"composable"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/es/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./lens": {
			"types": "./dist/lens.d.ts",
			"import": "./dist/es/lens.js",
			"require": "./dist/cjs/lens.cjs"
		},
		"./prism": {
			"types": "./dist/prism.d.ts",
			"import": "./dist/es/prism.js",
			"require": "./dist/cjs/prism.cjs"
		},
		"./traversal": {
			"types": "./dist/traversal.d.ts",
			"import": "./dist/es/traversal.js",
			"require": "./dist/cjs/traversal.cjs"
		},
		"./iso": {
			"types": "./dist/iso.d.ts",
			"import": "./dist/es/iso.js",
			"require": "./dist/cjs/iso.cjs"
		},
		"./compose": {
			"types": "./dist/compose.d.ts",
			"import": "./dist/es/compose.js",
			"require": "./dist/cjs/compose.cjs"
		},
		"./builder": {
			"types": "./dist/builder.d.ts",
			"import": "./dist/es/builder.js",
			"require": "./dist/cjs/builder.cjs"
		}
	},
	"scripts": {
		"prepublish": "pnpm run build",
		"build": "tsc -p ./tsconfig.build.json && vite build",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"type-check": "tsc --noEmit",
		"coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"@oofp/core": "workspace:*"
	},
	"devDependencies": {
		"@oofp/core": "workspace:*"
	}
}
