{
	"name": "@oofp/query",
	"version": "2.0.0",
	"description": "Functional query cache library for TypeScript with tag-based invalidation and telemetry",
	"license": "MIT",
	"author": "thexpert507",
	"homepage": "https://oofp.js.org/packages/query/",
	"bugs": {
		"url": "https://github.com/thexpert507/oofp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thexpert507/oofp.git",
		"directory": "packages/query"
	},
	"keywords": [
		"functional-programming",
		"typescript",
		"fp",
		"query",
		"cache",
		"lru",
		"redis",
		"type-safe",
		"telemetry"
	],
	"type": "module",
	"main": "./dist/es/index.js",
	"module": "./dist/es/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/es/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"files": ["dist"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json && vite build",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"type-check": "tsc --noEmit",
		"coverage": "vitest run --coverage",
		"bench": "vitest bench"
	},
	"peerDependencies": {
		"@oofp/core": "workspace:^",
		"redis": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"redis": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oofp/core": "workspace:*",
		"redis": "^5.9.0"
	}
}
