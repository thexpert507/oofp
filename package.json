{
	"name": "oofp",
	"private": true,
	"description": "OOFP - Object-Oriented Functional Programming ecosystem for TypeScript",
	"packageManager": "pnpm@10.6.2",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"test": "pnpm -r --filter './packages/*' run test",
		"test:watch": "pnpm -r --filter './packages/*' run test:watch",
		"type-check": "pnpm -r --filter './packages/*' run type-check",
		"lint": "biome check .",
		"format": "biome format --write .",
		"changeset": "changeset",
		"version": "changeset version",
		"publish": "pnpm build && changeset publish",
		"docs:dev": "pnpm --filter @oofp/docs run dev",
		"docs:build": "pnpm --filter @oofp/docs run build",
		"docs:preview": "pnpm --filter @oofp/docs run preview"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp"]
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@changesets/cli": "^2.29.4",
		"@types/node": "^24.10.1",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^4.0.5"
	}
}
